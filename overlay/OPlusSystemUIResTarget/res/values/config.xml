<resources>

    <!-- Whether to enable framework dimming for UDFPS -->
    <!-- The panel uses global HBM only (no local HBM). SDM asserts
         fingerprint_mask / OFP HBM when "Dim Layer for UDFPS" is composed
         with non-zero alpha. SystemUI keeps that window attached on
         keyguard at alpha 0, and snaps alpha on finger-down so HBM cannot
         race ahead of the dim. -->
    <bool name="config_udfpsFrameworkDimming">true</bool>

</resources>
