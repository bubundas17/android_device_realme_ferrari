From 1f6a277ea1a104d251bbe11f927b5efc06e18a13 Mon Sep 17 00:00:00 2001
From: Bubun Das <bubundas17@gmail.com>
Date: Mon, 10 Aug 2026 10:11:36 +0000
Subject: [PATCH] compat: add OPLUS system compatibility shims

---
 Android.bp                                    |  55 ++++++++++++++++++
 libprotobuf/arm/libprotobuf-cpp-lite-21.7.so  | Bin 406652 -> 558705 bytes
 .../arm64/libprotobuf-cpp-lite-21.7.so        | Bin 568848 -> 752457 bytes
 3 files changed, 55 insertions(+)

diff --git a/Android.bp b/Android.bp
index c67716f..951f3e5 100644
--- a/Android.bp
+++ b/Android.bp
@@ -310,6 +310,16 @@ cc_library {
     system_ext_specific: true,
 }
 
+cc_library_shared {
+    name: "libgui_shim_shared",
+    defaults: ["libgui_shim_defaults"],
+    shared_libs: [
+        "libgui",
+        "libutils",
+    ],
+    system_ext_specific: true,
+}
+
 cc_library {
     name: "libgui_shim_vendor",
     defaults: ["libgui_shim_defaults"],
@@ -580,6 +590,7 @@ cc_library_shared {
     shared_libs: [
         "android.media.audio.common.types-V5-cpp",
         "audioclient-types-aidl-cpp",
+        "libaudiobase",
         "libaudioclient",
         "libaudiofoundation",
         "libutils",
@@ -919,6 +930,30 @@ cc_prebuilt_library_shared {
     compile_multilib: "both",
 }
 
+cc_prebuilt_library_shared {
+    name: "libprotobuf-cpp-full-systemcompat",
+    stem: "libprotobuf-cpp-full",
+    system_ext_specific: true,
+    check_elf_files: false,
+    strip: {
+        none: true,
+    },
+    shared_libs: [
+        "libc++",
+        "liblog",
+        "libz",
+    ],
+    target: {
+        android_arm: {
+            srcs: ["libprotobuf/arm/libprotobuf-cpp-full-21.7.so"],
+        },
+        android_arm64: {
+            srcs: ["libprotobuf/arm64/libprotobuf-cpp-full-21.7.so"],
+        },
+    },
+    compile_multilib: "both",
+}
+
 cc_prebuilt_library_shared {
     name: "libprotobuf-cpp-lite-vendorcompat",
     stem: "libprotobuf-cpp-lite",
@@ -940,6 +975,26 @@ cc_prebuilt_library_shared {
     compile_multilib: "both",
 }
 
+cc_prebuilt_library_shared {
+    name: "libprotobuf-cpp-lite-systemcompat",
+    stem: "libprotobuf-cpp-lite",
+    system_ext_specific: true,
+    check_elf_files: false,
+    strip: {
+        none: true,
+    },
+    shared_libs: ["libc++"],
+    target: {
+        android_arm: {
+            srcs: ["libprotobuf/arm/libprotobuf-cpp-lite-21.7.so"],
+        },
+        android_arm64: {
+            srcs: ["libprotobuf/arm64/libprotobuf-cpp-lite-21.7.so"],
+        },
+    },
+    compile_multilib: "both",
+}
+
 cc_prebuilt_library_shared {
     name: "libstagefright_foundation-v33",
     system_ext_specific: true,
