From 84a5b44ba54a78ac57216e88a404fe64437c6cdc Mon Sep 17 00:00:00 2001
From: Bubun Das <bubundas17@gmail.com>
Date: Wed, 12 Aug 2026 17:33:12 +0000
Subject: [PATCH 4/4] composer: restore color transform after display power-on

Restoring PCC before SetDisplayState is lost when the panel powers up,
causing a cold Night Light flash on wake. Restore after the power mode
change instead.

Co-authored-by: Cursor <cursoragent@cursor.com>
---
 composer/hwc_display.cpp | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/composer/hwc_display.cpp b/composer/hwc_display.cpp
index 5965704a96..dbd259388a 100644
--- a/composer/hwc_display.cpp
+++ b/composer/hwc_display.cpp
@@ -983,7 +983,8 @@ HWC2::Error HWCDisplay::SetPowerMode(HWC2::PowerMode mode, bool teardown) {
           current_power_mode_ == HWC2::PowerMode::DozeSuspend)) {
         return HWC2::Error::None;
       }
-      RestoreColorTransform();
+      // Night Light / PCC must be restored *after* SetDisplayState below.
+      // Restoring here is lost when the panel powers on (cold flash on wake).
       state = kStateOn;
       break;
     case HWC2::PowerMode::Doze:
@@ -992,7 +993,6 @@ HWC2::Error HWCDisplay::SetPowerMode(HWC2::PowerMode mode, bool teardown) {
           current_power_mode_ == HWC2::PowerMode::DozeSuspend)) {
         return HWC2::Error::None;
       }
-      RestoreColorTransform();
       state = kStateDoze;
       break;
     case HWC2::PowerMode::DozeSuspend:
@@ -1008,6 +1008,11 @@ HWC2::Error HWCDisplay::SetPowerMode(HWC2::PowerMode mode, bool teardown) {
 
   if (error == kErrorNone) {
     flush_on_error_ = flush_on_error;
+    // Re-apply cached color transform after the panel is actually on/doze.
+    // Doing this before SetDisplayState loses Night Light PCC on power-up.
+    if (mode == HWC2::PowerMode::On || mode == HWC2::PowerMode::Doze) {
+      RestoreColorTransform();
+    }
   } else {
     if (error == kErrorShutDown) {
       shutdown_pending_ = true;
-- 
