+#pragma once
+
+namespace pxlw {
+
+class IrisFeature {
+ public:
+  static IrisFeature* getInstance();
+  static IrisFeature* getFeature();
+
+  ~IrisFeature() = default;
+
+  bool hasIrisDual();
+  bool hasSoftIris();
+  bool hasIris5Dual();
+  bool hasIris7Dual();
+  bool hasIrisDualWithoutCSC();
+  bool hasIris();
