+/*
+ * SPDX-FileCopyrightText: 2025 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#pragma once
+
+namespace android {
+namespace hardware {
+namespace graphics {
+namespace common {
+namespace V1_1 {
+enum class RenderIntent : int32_t;
+}
+namespace V1_2 {
