+
+  IrisFeature(const IrisFeature&) = delete;
+  IrisFeature& operator=(const IrisFeature&) = delete;
+  IrisFeature(IrisFeature&&) = delete;
+  IrisFeature& operator=(IrisFeature&&) = delete;
+};
+
+}  // namespace pxlw
