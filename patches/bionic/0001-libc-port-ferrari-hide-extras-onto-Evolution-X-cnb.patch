From 95c9ff773fb59e74c2423661dc0652f95ee2a578 Mon Sep 17 00:00:00 2001
From: Bubun Das <bubundas17@gmail.com>
Date: Fri, 14 Aug 2026 16:31:01 +0000
Subject: [PATCH] libc: port ferrari hide extras onto Evolution-X cnb

Keep hide limited to untrusted/isolated apps, spoof partition
test-keys/wireless ADB/verified-boot props, and prefix-hide ROM
identity properties for app UIDs.

Co-authored-by: Cursor <cursoragent@cursor.com>
---
 libc/bionic/custom_rom_hide.cpp | 116 +++++++++++++++++++++++++++-----
 1 file changed, 101 insertions(+), 15 deletions(-)

diff --git a/libc/bionic/custom_rom_hide.cpp b/libc/bionic/custom_rom_hide.cpp
index 3b00f0d57..5a7fc20ef 100644
--- a/libc/bionic/custom_rom_hide.cpp
+++ b/libc/bionic/custom_rom_hide.cpp
@@ -27,6 +27,7 @@
 #include <stdlib.h>
 #include <string.h>
 #include <sys/stat.h>
+#include <sys/system_properties.h>
 #include <sys/statfs.h>
 #include <sys/syscall.h>
 #include <sys/sysmacros.h>
@@ -72,6 +73,7 @@ static const char* const kMountFilterKeywords[] = {
 
 static const char* const kAllowlistedPackages[] = {
     "org.lineageos.updater",
+    "com.android.systemui",
     nullptr
 };
 
@@ -193,9 +195,21 @@ static bool compute_allowlisted() {
 }
 
 static bool compute_app_process() {
+    // UID >= AID_APP_START also includes platform_app (SystemUI). Only hide
+    // from untrusted / isolated apps so Keyguard and privileged processes
+    // keep real properties.
     if ((getuid() % AID_USER_OFFSET) < AID_APP_START) return false;
     if (compute_allowlisted()) return false;
-    return true;
+
+    int fd = raw_openat("/proc/self/attr/current", O_RDONLY);
+    if (fd < 0) return false;
+    char ctx[256];
+    ssize_t n = raw_read(fd, ctx, sizeof(ctx) - 1);
+    raw_close(fd);
+    if (n <= 0) return false;
+    ctx[n] = '\0';
+    return strstr(ctx, "untrusted_app") != nullptr
+            || strstr(ctx, "isolated_app") != nullptr;
 }
 
 static bool is_app_process() {
@@ -721,17 +735,81 @@ int custom_rom_hide_filter_vintf(const char* path) {
 static const char* const kSpoofedEmptyProps[] = {
     "ro.evolution.version", "ro.evolution.build.version", "ro.evolution.display.version",
     "ro.lineage.version", "ro.lineage.build.version", "ro.cm.build.version",
-    "ro.modversion", "init.svc_debug_pid.adb_root",
-    "init.svc.adb_root", "service.adb.root", nullptr
+    "ro.modversion", "init.svc_debug_pid.adb_root", "init.svc_debug_pid.adbd",
+    "init.svc.adb_root", "init.svc.adbd", "service.adb.root",
+    "service.adb.tcp.port", nullptr
 };
 
+static const char* const kHiddenPropPrefixes[] = {
+    "ro.evolution.", "ro.evolutionlegal.", "ro.lineage.", "ro.cm.", nullptr
+};
+
+static bool ends_with(const char* name, const char* suffix) {
+    if (!name || !suffix) return false;
+    size_t nlen = strlen(name);
+    size_t slen = strlen(suffix);
+    return nlen >= slen && strcmp(name + (nlen - slen), suffix) == 0;
+}
+
+static bool is_build_tags_prop(const char* name) {
+    return strcmp(name, "ro.build.tags") == 0 || ends_with(name, ".build.tags");
+}
+
+static bool is_build_type_prop(const char* name) {
+    return strcmp(name, "ro.build.type") == 0 || ends_with(name, ".build.type");
+}
+
+static bool is_fingerprint_prop(const char* name) {
+    return strcmp(name, "ro.build.fingerprint") == 0
+            || ends_with(name, ".build.fingerprint");
+}
+
+static bool rewrite_fingerprint_value(char* value) {
+    if (!value || value[0] == '\0') return false;
+    bool changed = false;
+    char* p;
+    while ((p = strstr(value, "userdebug")) != nullptr) {
+        size_t tail = strlen(p + 9);
+        memmove(p + 4, p + 9, tail + 1);
+        memcpy(p, "user", 4);
+        changed = true;
+    }
+    while ((p = strstr(value, "test-keys")) != nullptr) {
+        size_t head = static_cast<size_t>(p - value);
+        size_t tail = strlen(p + 9);
+        if (head + 12 + tail >= PROP_VALUE_MAX) break;
+        memmove(p + 12, p + 9, tail + 1);
+        memcpy(p, "release-keys", 12);
+        changed = true;
+    }
+    return changed;
+}
+
+static bool is_hidden_prop_name(const char* name) {
+    for (const char* const* prop = kSpoofedEmptyProps; *prop; ++prop) {
+        if (strcmp(name, *prop) == 0) return true;
+    }
+    for (const char* const* prefix = kHiddenPropPrefixes; *prefix; ++prefix) {
+        if (strncmp(name, *prefix, strlen(*prefix)) == 0) return true;
+    }
+    return false;
+}
+
 struct PropOverride { const char* name; const char* value; };
 static const PropOverride kSpoofedValueProps[] = {
-    {"ro.debuggable", "0"},
-    {"ro.build.type", "user"},
-    {"ro.build.tags", "release-keys"},
-    {"ro.secure", "1"},
-    {"ro.adb.secure", "1"},
+    {"ro.debuggable", "0"}, {"ro.force.debuggable", "0"},
+    {"persist.sys.evox_debug_enabled", "0"},
+    {"ro.build.type", "user"}, {"ro.build.tags", "release-keys"},
+    {"ro.secure", "1"}, {"ro.adb.secure", "1"}, {"persist.sys.usb.config", "mtp"},
+    {"sys.usb.config", "mtp"},
+    {"ro.boot.verifiedbootstate", "green"},
+    {"ro.boot.flash.locked", "1"},
+    {"ro.boot.vbmeta.device_state", "locked"},
+    {"ro.boot.warranty_bit", "0"},
+    {"ro.warranty_bit", "0"},
+    {"ro.secureboot.lockstate", "locked"},
+    {"sys.oem_unlock_allowed", "0"},
+    {"ro.oem_unlock_supported", "0"},
     {nullptr, nullptr}
 };
 
@@ -740,22 +818,28 @@ bool custom_rom_hide_should_spoof_prop(const char* name, char* value) {
     if (reinterpret_cast<uintptr_t>(name) < 0x1000000) return false;
     if (reinterpret_cast<uintptr_t>(value) < 0x1000000) return false;
     if (!is_app_process()) return false;
-    for (const char* const* p = kSpoofedEmptyProps; *p; ++p) {
-        if (strcmp(name, *p) == 0) { value[0] = '\0'; return true; }
-    }
+    if (is_hidden_prop_name(name)) { value[0] = '\0'; return true; }
     for (const PropOverride* o = kSpoofedValueProps; o->name; ++o) {
         if (strcmp(name, o->name) == 0) { strcpy(value, o->value); return true; }
     }
+    if (is_build_tags_prop(name)) {
+        strcpy(value, "release-keys");
+        return true;
+    }
+    if (is_build_type_prop(name)) {
+        strcpy(value, "user");
+        return true;
+    }
+    if (is_fingerprint_prop(name) && rewrite_fingerprint_value(value)) {
+        return true;
+    }
     return false;
 }
 
 bool custom_rom_hide_should_hide_prop(const char* name) {
     if (!name || reinterpret_cast<uintptr_t>(name) < 0x1000000) return false;
     if (!is_app_process()) return false;
-    for (const char* const* p = kSpoofedEmptyProps; *p; ++p) {
-        if (strcmp(name, *p) == 0) return true;
-    }
-    return false;
+    return is_hidden_prop_name(name);
 }
 
 const char* custom_rom_hide_get_prop_override(const char* name) {
@@ -764,6 +848,8 @@ const char* custom_rom_hide_get_prop_override(const char* name) {
     for (const PropOverride* o = kSpoofedValueProps; o->name; ++o) {
         if (strcmp(name, o->name) == 0) return o->value;
     }
+    if (is_build_tags_prop(name)) return "release-keys";
+    if (is_build_type_prop(name)) return "user";
     return nullptr;
 }
 
-- 
2.43.0

