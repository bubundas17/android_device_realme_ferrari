From 24da7685ed44080e1d2e155f50b87a0fcb4d2ec8 Mon Sep 17 00:00:00 2001
From: Bubun Das <bubundas17@gmail.com>
Date: Sat, 8 Aug 2026 13:06:35 +0000
Subject: [PATCH 08/15] SystemUI: Show UDFPS dim layer during AOD fingerprint
 press

While the display is dozing the dim layer is hidden because the shade is
not touchable, so the global HBM used to illuminate the optical sensor
flashes the whole screen up unmasked. Show the dim layer for the
duration of the fingerprint press so the AOD press stays dark and only
the sensor circle lights up, matching lockscreen behavior.
---
 .../systemui/biometrics/UdfpsController.java  |  8 ++++-
 .../biometrics/UdfpsControllerOverlay.kt      |  4 +++
 .../systemui/biometrics/UdfpsHelper.kt        | 29 +++++++++++++++----
 3 files changed, 34 insertions(+), 7 deletions(-)

diff --git a/packages/SystemUI/src/com/android/systemui/biometrics/UdfpsController.java b/packages/SystemUI/src/com/android/systemui/biometrics/UdfpsController.java
index 07ef83d1bdb5..54a18bc106fa 100644
--- a/packages/SystemUI/src/com/android/systemui/biometrics/UdfpsController.java
+++ b/packages/SystemUI/src/com/android/systemui/biometrics/UdfpsController.java
@@ -660,7 +660,10 @@ public class UdfpsController implements DozeReceiver, Dumpable {
             // It's possible on some devices to get duplicate touches from both doze and the
             // normal touch listener. Don't reset the down in this case to avoid duplicate downs
             if (!mIsAodInterruptActive) {
-                mOnFingerDown = false;
+        mOnFingerDown = false;
+        if (mOverlay != null) {
+            mOverlay.setFingerDown(false);
+        }
             }
         }
 
@@ -1273,6 +1276,9 @@ public class UdfpsController implements DozeReceiver, Dumpable {
             mDeviceEntryFaceAuthInteractor.onUdfpsSensorTouched();
         }
         mOnFingerDown = true;
+        if (mOverlay != null) {
+            mOverlay.setFingerDown(true);
+        }
         mFingerprintManager.onPointerDown(requestId, mSensorProps.sensorId, pointerId, x, y,
                 minor, major, orientation, time, gestureStart, isAod);
 
diff --git a/packages/SystemUI/src/com/android/systemui/biometrics/UdfpsControllerOverlay.kt b/packages/SystemUI/src/com/android/systemui/biometrics/UdfpsControllerOverlay.kt
index 5a0165136f42..453007ee3a0d 100644
--- a/packages/SystemUI/src/com/android/systemui/biometrics/UdfpsControllerOverlay.kt
+++ b/packages/SystemUI/src/com/android/systemui/biometrics/UdfpsControllerOverlay.kt
@@ -136,6 +136,10 @@ constructor(
         return overlayTouchView
     }
 
+    fun setFingerDown(fingerDown: Boolean) {
+        udfpsHelper?.setFingerDown(fingerDown)
+    }
+
     private var overlayParams: UdfpsOverlayParams = UdfpsOverlayParams()
     private var sensorBounds: Rect = Rect()
 
diff --git a/packages/SystemUI/src/com/android/systemui/biometrics/UdfpsHelper.kt b/packages/SystemUI/src/com/android/systemui/biometrics/UdfpsHelper.kt
index f46ea8f74489..f5cdbfaeaf3d 100644
--- a/packages/SystemUI/src/com/android/systemui/biometrics/UdfpsHelper.kt
+++ b/packages/SystemUI/src/com/android/systemui/biometrics/UdfpsHelper.kt
@@ -202,15 +202,32 @@ class UdfpsHelper(
         }
     }
 
+    private var isShadeTouchable: Boolean = false
+
+    private var isFingerDown: Boolean = false
+
+    fun setFingerDown(fingerDown: Boolean) {
+        if (!isKeyguard || isFingerDown == fingerDown) {
+            return
+        }
+        isFingerDown = fingerDown
+        updateDimLayerVisibility()
+    }
+
+    private fun updateDimLayerVisibility() {
+        view.isVisible = isShadeTouchable || isFingerDown
+        if (view.isVisible) {
+            brightnessToAlpha()
+            alphaAnimator.cancel()
+            alphaAnimator.start()
+        }
+    }
+
     private suspend fun listenForShadeTouchability(scope: CoroutineScope): Job {
         return scope.launch {
             shadeInteractor.isShadeTouchable.collect {
-                view.isVisible = it
-                if (view.isVisible) {
-                    brightnessToAlpha()
-                    alphaAnimator.cancel()
-                    alphaAnimator.start()
-                }
+                isShadeTouchable = it
+                updateDimLayerVisibility()
             }
         }
     }
