+
+    @Test
+    public void sanitizeUsbStateForPackage_enabledPackageGetsDisconnectedCopy() {
+        Intent original = new Intent(UsbManager.ACTION_USB_STATE)
+                .putExtra(UsbManager.USB_CONNECTED, true)
+                .putExtra(UsbManager.USB_CONFIGURED, true)
+                .putExtra(UsbManager.USB_FUNCTION_ADB, true);
+
+        Intent sanitized = BroadcastController.sanitizeUsbStateForPackage(
+                original, TEST_PKG, true);
+
+        assertThat(sanitized).isNotSameInstanceAs(original);
+        assertThat(sanitized.getBooleanExtra(UsbManager.USB_CONNECTED, true)).isFalse();
+        assertThat(sanitized.getBooleanExtra(UsbManager.USB_CONFIGURED, true)).isFalse();
+        assertThat(sanitized.getBooleanExtra(UsbManager.USB_FUNCTION_ADB, true)).isFalse();
+        assertThat(original.getBooleanExtra(UsbManager.USB_CONNECTED, false)).isTrue();
+    }
+
+    @Test
+    public void sanitizeUsbStateForPackage_disabledPackageGetsOriginal() {
+        Intent original = new Intent(UsbManager.ACTION_USB_STATE)
+                .putExtra(UsbManager.USB_CONNECTED, true);
+
+        Intent result = BroadcastController.sanitizeUsbStateForPackage(original, TEST_PKG, false);
+
+        assertThat(result).isSameInstanceAs(original);
+        assertThat(result.getBooleanExtra(UsbManager.USB_CONNECTED, false)).isTrue();
+    }
 }
