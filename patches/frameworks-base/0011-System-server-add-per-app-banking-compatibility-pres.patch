-        if (!mAppControlController.isSpoofSettingEnabled(callingPackage, settingName)) {
+        final boolean settingEnabled =
+                mAppControlController.isSpoofSettingEnabled(callingPackage, settingName);
+        final boolean bankingPresetEnabled = SettingsSpoofController
